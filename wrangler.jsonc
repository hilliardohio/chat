{
  // Configuration for the Hilliard Assistant Cloudflare Worker.
  //
  // These values were read from the live Worker on 2026-09-06 and must keep matching it.
  // Cloudflare treats this file as the source of truth on every Git deploy: any KV binding
  // or plain-text variable NOT listed here is REMOVED from the Worker. Secrets are the
  // exception -- ADMIN_PASSWORD and OPENGOV_API_KEY are stored encrypted on the Worker and
  // are preserved across deploys, which is why they do not (and must not) appear here.
  "$schema": "node_modules/wrangler/config-schema.json",

  // Must exactly match the Worker name in the Cloudflare dashboard or the build fails.
  "name": "hilliard-assistant",
  "main": "worker.js",
  "compatibility_date": "2026-08-26",

  // Keeps https://hilliard-assistant.ralley.workers.dev serving the API.
  "workers_dev": true,

  // Persist logs to the dashboard so a failing request can be diagnosed after the fact
  // instead of guessing from a generic error.
  "observability": { "enabled": true },

  // Stores the Claude API key, knowledge base, topic overrides, chat log and caches.
  // Deleting or renaming this binding wipes the assistant's configuration.
  "kv_namespaces": [
    { "binding": "KV", "id": "8c3856d9348a4681b4fab52d292014d4" }
  ],

  // Only the browser origin allowed to call the API. GLOBAL_DAILY_LIMIT and IP_HOURLY_LIMIT
  // are deliberately absent -- they are unset on the live Worker, so the code defaults apply.
  "vars": {
    "ALLOWED_ORIGIN": "https://hilliardohio.github.io"
  }
}
